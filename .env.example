# GitHub Remote Data Access Configuration
# Copy this file to .env and configure as needed.
# NEVER commit your real .env file or GitHub tokens to source control!

# Optional GitHub Personal Access Token (Read-Only: Contents: Read)
# Leave empty for public repository access
GITHUB_TOKEN=your_read_only_token_here

# GitHub Repository Details
GITHUB_OWNER=Muhammad-Wasif
GITHUB_REPO=text-ml-benchmark
GITHUB_REF=main

# Custom Remote REST API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Optional API Key to protect the custom REST API service (leave empty for public read)
API_KEY=
